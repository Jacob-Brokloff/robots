# Copy to deploy/.env (gitignored) and fill in. Both compose files read it.

# --- desktop robot-client ---
PI_IP=192.168.1.114
# xlerobot_2wheels_client (our robot) or xlerobot_client (3-omniwheel build)
XLEROBOT_TYPE=xlerobot_2wheels_client
LEFT_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79017318-if00
RIGHT_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90040979-if00
# Zenoh hub on the VM (CP4). Leave empty to keep the mesh on this machine.
ZENOH_CONNECT=
# Operator consent: POC only. Lets teleop/agent motion run without the interactive prompt.
BYPASS_TOOL_CONSENT=false

# --- mesh (both hosts) ---
STRANDS_MESH_LOCAL_DEV=true
# Required once the mesh crosses hosts with auth off (no mTLS for the POC).
STRANDS_MESH_I_KNOW_THIS_IS_INSECURE=1

# --- VM agent + dashboard ---
# Required to bind the dashboard to 0.0.0.0 (otherwise loopback only).
DASHBOARD_AUTH_TOKEN=change-me
OPENAI_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
OPENAI_API_KEY=change-me
MODEL_ID=Qwen/Qwen3-32B-AWQ
