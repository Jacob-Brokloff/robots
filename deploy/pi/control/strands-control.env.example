# ~/strands-control.env on the Pi, read by xlerobot-control.service and by hand runs of pi_control.py.
# ~/strands-control.env is read by xlerobot-control.service (`pi_control.py serve`) and by hand runs of
# `pi_control.py run`, which take POLICY_* as defaults.
# PolicyServer to drive the robot: scripts/serve_nudge.py on the VM first (CP11), the pod later (CP14).
POLICY_ENDPOINT=ws://strands-control:8765
POLICY_INSTRUCTION=
# One rollout's wall-clock budget, seconds.
POLICY_DURATION=10
# The host loops at 30 Hz.
CONTROL_FREQUENCY=30
ROBOT_REMOTE_IP=127.0.0.1
# xlerobot_2wheels = the real client in real mode and the sim model for the dashboard twin.
XLEROBOT_TYPE=xlerobot_2wheels
MESH_PEER_ID=woodside

# Mesh: dial the VM's Zenoh hub over the tailnet (CP7). Auth stays off for the POC.
ZENOH_CONNECT=tcp/100.70.150.7:7447
STRANDS_MESH_LOCAL_DEV=true
STRANDS_MESH_I_KNOW_THIS_IS_INSECURE=1
# Camera frames on the mesh for the dashboard (JPEG q80, ~150 KB per tick for 3 cameras). Off when unset.
STRANDS_MESH_CAMERA_HZ=5
# Wire motion this robot accepts without a per-call grant: teleop from the desktop dashboard only
# (peer id pinned by STRANDS_DASHBOARD_PEER_ID in deploy/desktop/docker-compose.yml).
STRANDS_ROBOT_COMMAND_ALLOW=teleop_receive@dashboard-desktop
