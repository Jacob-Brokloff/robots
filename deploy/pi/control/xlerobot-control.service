# systemd *user* unit for the robot's Strands peer (`pi_control.py serve`, peer id `woodside`). Installed by
# install.sh, enabled: it owns the one client of xlerobot-host, publishes state and cameras on the mesh and
# answers fleet `stop`. It moves nothing by itself; rollouts come from `pi_control.py run` over its local socket.
#   systemctl --user restart xlerobot-control && systemctl --user status xlerobot-control -n 50
[Unit]
Description=Strands peer woodside: xlerobot_2wheels_client on the mesh + policy rollouts on request
After=xlerobot-host.service
Requires=xlerobot-host.service
# Restart with the host, so the client reconnects to a fresh one.
PartOf=xlerobot-host.service

[Service]
Type=simple
EnvironmentFile=%h/strands-control.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@REPO@/scripts
ExecStart=@VENV@/bin/python @REPO@/scripts/pi_control.py serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
