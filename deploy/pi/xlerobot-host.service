# systemd *user* unit (linger is on for woodside, so it runs without a login).
# Installed by install.sh to ~/.config/systemd/user/. It needs the motor buses to itself:
# stop woodside-supervisor first (it holds both ports), see CLAUDE.md.
[Unit]
Description=XLeRobot 2-wheel lerobot host (ZMQ cmd 5555, observations 5556)
After=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# connect() asks on stdin whether to restore calibration from file; answer Enter (restore).
# port1 = left arm + head bus, port2 = right arm + wheels bus. xlerobot_host.py wraps the plugin host
# to add the cameras in cameras.json (CP11); the plugin's own CLI cannot configure any.
ExecStart=/bin/sh -c 'printf "\\n" | exec @VENV@/bin/python @HERE@/xlerobot_host.py \
    --robot.id=@ROBOT_ID@ --robot.port1=@PORT1@ --robot.port2=@PORT2@ --cameras=@HERE@/cameras.json'
# The host exits after connection_time_s (3600 s); bring it back.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
