[Unit]
Description=XLeRobot lerobot host (ZMQ cmd 5555, observations 5556)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@HOME@
Environment=PYTHONUNBUFFERED=1
# Host main() hardcodes robot id "my_xlerobot_pc", bus ports /dev/ttyACM0 + /dev/ttyACM1,
# and exits after connection_time_s (3600 s); Restart=always brings it back.
ExecStart=@VENV@/bin/python -m lerobot_robot_xlerobot.xlerobot_host
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
